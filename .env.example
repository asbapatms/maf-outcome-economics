# Azure OpenAI. Copy this file to .env and replace placeholders locally.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_MODEL=your-deployment-name
AZURE_OPENAI_API_VERSION=preview
# Prefer Azure CLI or managed identity. Set a key only when required.
AZURE_OPENAI_API_KEY=

# OpenTelemetry. Sensitive prompt and response capture stays disabled.
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=false
ENABLE_CONSOLE_EXPORTERS=false
OTEL_SERVICE_NAME=maf-outcome-economics
# Set this to send the same safe traces to an Application Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Set OTEL_EXPORTER_OTLP_ENDPOINT only when an OTLP collector is running.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Local persistence
MAF_DATABASE_PATH=data/outcomes.db